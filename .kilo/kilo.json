{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "jupyter": {
      "type": "remote",
      "url": "http://127.0.0.1:3001/mcp"
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Users\\36266\\Desktop\\大创 开发"
      ]
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "environment": {
        "DEFAULT_MINIMUM_TOKENS": "{{DEFAULT_MINIMUM_TOKENS}}"
      }
    },
    "git": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git",
        "--repository",
        "C:\\Users\\36266\\Desktop\\大创 开发"
      ]
    }
  }
}
