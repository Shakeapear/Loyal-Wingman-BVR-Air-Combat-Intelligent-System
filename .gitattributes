* text=auto

# 服务器上的 shell 脚本必须是 LF，否则 bash 会报 bad interpreter: /bin/bash^M
*.sh text eol=lf
*.bash text eol=lf

# Python/文档/配置统一 LF，避免跨平台 diff 与 shebang 问题
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf

# 二进制/数据文件不做换行转换
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.npz binary
*.docx binary
*.pdf binary
*.exe binary
*.dll binary
*.xz binary
